{
  "name": "probex-platform",
  "version": "0.1.0",
  "private": true,
  "description": "ProbeX Runtime Debugger",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest --coverage",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "verify": "pnpm lint && pnpm format && pnpm typecheck && pnpm test:coverage",
    "verify:fix": "pnpm lint:fix && pnpm format:fix"
  },
  "keywords": [],
  "author": "Artem Horovyi",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@probex-platform/configs": "workspace:*",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
