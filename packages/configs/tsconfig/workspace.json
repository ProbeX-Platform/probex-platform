{
  "extends": "./base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist",
    "tsBuildInfoFile": "${configDir}/dist/tsconfig.tsbuildinfo"
  },
  "include": ["${configDir}/src"],
  "exclude": ["${configDir}/dist", "${configDir}/node_modules", "${configDir}/src/**/*.test.ts"]
}
