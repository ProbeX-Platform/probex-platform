{
  "name": "@probex/configs",
  "version": "1.0.0",
  "description": "Shared TypeScript, ESLint, Prettier and Vitest configs",
  "type": "module",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/workspace.json": "./tsconfig/workspace.json",
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    },
    "./prettier": {
      "types": "./prettier/index.d.ts",
      "default": "./prettier/index.js"
    },
    "./vitest": {
      "types": "./vitest/index.d.ts",
      "default": "./vitest/index.js"
    }
  },
  "files": [
    "tsconfig",
    "eslint",
    "prettier",
    "vitest"
  ],
  "keywords": [],
  "author": "Artem Horovyi",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-plugin-import-x": "^4.17.1",
    "typescript-eslint": "^8.66.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": ">=5.8",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
